<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/nav_graph"
app:startDestination="@id/loginFragment" >
<fragment
    android:id="@+id/loginFragment"
    android:name="ru.snubmaze.chatapp.ui.login.LoginFragment"
    android:label="@string/login_screen_title" >

    <action
        android:id="@+id/action_login_to_channels"
        app:destination="@id/channelsFragment"
        app:popUpTo="@id/loginFragment"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/channelsFragment"
    android:name="ru.snubmaze.chatapp.ui.channels.ChannelsFragment"
    android:label="@string/channels_screen_title" >

    <action
        android:id="@+id/action_channels_to_messages"
        app:destination="@id/messagesFragment" />
    <action
        android:id="@+id/action_channels_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/messagesFragment"
    android:name="ru.snubmaze.chatapp.ui.messages.MessagesFragment"
    android:label="@string/messages_screen_title" >

    <argument
        android:name="channelName"
        app:argType="string" />

    <action
        android:id="@+id/action_messages_to_image"
        app:destination="@id/imageFragment" />
    <action
        android:id="@+id/action_messages_to_channels"
        app:destination="@id/channelsFragment"
        app:popUpTo="@id/channelsFragment"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/imageFragment"
    android:name="ru.snubmaze.chatapp.ui.image.ImageFragment"
    android:label="@string/image_screen_title" >

    <argument
        android:name="imagePath"
        app:argType="string" />

    <action
        android:id="@+id/action_image_to_messages"
        app:destination="@id/messagesFragment"
        app:popUpTo="@id/messagesFragment"
        app:popUpToInclusive="true" />

</fragment>
</navigation>